# Published HTTP port on the Docker host.
SAI_WEB_PORT=8000

# Serial device on the host that is mapped into the container.
SAI_DEVICE=/dev/ttyUSB0

# GID of the group that owns the serial device on the host.
# Find it with: stat -c '%g' /dev/ttyUSB0
SAI_DIALOUT_GID=20

# Display name shown in the dashboard and API.
SAI_NAME=Woxter UPS 650 VA

# Title shown in the browser tab and dashboard header. Change it to any text.
SAI_WEB_TITLE=UPS Monitor

# Seconds between Q1 samples. 1 s is useful for diagnostics; 5 s is a good
# long-term default for home monitoring and reduces database writes.
SAI_INTERVAL=1

# Number of days of samples and outage summaries to keep. Use 0 to keep
# everything forever.
SAI_RETENTION_DAYS=30

# SQLite database path inside the container. Keep it under /data so the named
# volume persists it.
# SAI_DB=/data/sai.db

# Set to 1 to run without a serial port. Useful for testing the UI.
SAI_SIMULATE=0

# UPS and battery parameters. The battery nominal voltage is read from the
# UPS F command when available; this value is only used as a fallback.
SAI_BATTERY_NOMINAL=12
SAI_BATTERY_AH=7
SAI_UPS_VA=650
SAI_UPS_WATTS=360

# Optional explicit voltage limits for the charge estimate. When empty they are
# derived from SAI_BATTERY_NOMINAL (12 V -> 10.4 V / 13.0 V).
# SAI_BATTERY_LOW=10.4
# SAI_BATTERY_HIGH=13.0

# Optional battery state thresholds in volts. When empty they are derived from
# SAI_BATTERY_NOMINAL (12 V -> 11.6 V / 13.0 V / 13.6 V).
# SAI_BATTERY_STATE_LOW_V=11.6
# SAI_BATTERY_STATE_CHARGED_V=13.0
# SAI_BATTERY_STATE_CHARGING_V=13.6

SAI_LOG_LEVEL=INFO
TZ=Europe/Madrid

# Only used by docker-compose.macvlan.yml (advanced fixed-IP deployment).
# SAI_CONTAINER_IP=192.168.1.50
# SAI_NETWORK_NAME=sai_macvlan
